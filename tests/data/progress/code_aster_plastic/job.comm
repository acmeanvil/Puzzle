DEBUT(LANG='EN')
mesh = LIRE_MAILLAGE(FORMAT='MED', UNITE=20)
model = AFFE_MODELE(MAILLAGE=mesh, AFFE=(_F(TOUT='OUI', PHENOMENE='MECANIQUE', MODELISATION='3D'),))
trac1 = DEFI_FONCTION(NOM_PARA='EPSI', VALE=(0.00125, 250000000, 0.1015, 300000000), PROL_DROITE='CONSTANT', PROL_GAUCHE='EXCLU')
mat1 = DEFI_MATERIAU(ELAS=_F(E=200000000000, NU=0.3, RHO=7850), TRACTION=_F(SIGM=trac1))
mater = AFFE_MATERIAU(MAILLAGE=mesh, AFFE=(_F(GROUP_MA='G1', MATER=mat1),))
load = AFFE_CHAR_MECA(MODELE=model, DDL_IMPO=(_F(GROUP_MA='G2', DX=0), _F(GROUP_MA='G3', DY=0), _F(GROUP_MA='G4', DZ=0), _F(GROUP_MA='G5', DX=0.001),))
ramp = DEFI_FONCTION(NOM_PARA='INST', VALE=(0.0, 0.0, 1.0, 1.0))
times = DEFI_LIST_INST(DEFI_LIST=_F(LIST_INST=DEFI_LIST_REEL(DEBUT=0.0, INTERVALLE=_F(JUSQU_A=1.0, NOMBRE=10))), ECHEC=_F(EVENEMENT='ERREUR', ACTION='DECOUPE', SUBD_METHODE='MANUEL', SUBD_PAS=4, SUBD_NIVEAU=5))
res = STAT_NON_LINE(MODELE=model, CHAM_MATER=mater, EXCIT=(_F(CHARGE=load, FONC_MULT=ramp),), COMPORTEMENT=(_F(GROUP_MA=('G1',), RELATION='VMIS_ISOT_TRAC'),), NEWTON=_F(REAC_ITER=1), CONVERGENCE=_F(ITER_GLOB_MAXI=200, RESI_GLOB_RELA=1e-6), INCREMENT=_F(LIST_INST=times))
res = CALC_CHAMP(reuse=res, RESULTAT=res, CONTRAINTE=('SIGM_NOEU',), FORCE=('REAC_NODA',), VARI_INTERNE=('VARI_NOEU',), DEFORMATION=('EPSP_NOEU',))
IMPR_TABLE(TABLE=CREA_TABLE(RESU=_F(RESULTAT=res, NOM_CHAM='DEPL', TOUT_CMP='OUI', TOUT='OUI')), UNITE=81, FORMAT='TABLEAU', SEPARATEUR=',', FORMAT_R='1PE18.10')
IMPR_TABLE(TABLE=CREA_TABLE(RESU=_F(RESULTAT=res, NOM_CHAM='SIGM_NOEU', TOUT_CMP='OUI', TOUT='OUI')), UNITE=82, FORMAT='TABLEAU', SEPARATEUR=',', FORMAT_R='1PE18.10')
IMPR_TABLE(TABLE=CREA_TABLE(RESU=_F(RESULTAT=res, NOM_CHAM='REAC_NODA', TOUT_CMP='OUI', TOUT='OUI')), UNITE=85, FORMAT='TABLEAU', SEPARATEUR=',', FORMAT_R='1PE18.10')
IMPR_TABLE(TABLE=CREA_TABLE(RESU=_F(RESULTAT=res, NOM_CHAM='EPSP_NOEU', TOUT_CMP='OUI', TOUT='OUI')), UNITE=86, FORMAT='TABLEAU', SEPARATEUR=',', FORMAT_R='1PE18.10')
IMPR_TABLE(TABLE=CREA_TABLE(RESU=_F(RESULTAT=res, NOM_CHAM='VARI_NOEU', TOUT_CMP='OUI', TOUT='OUI')), UNITE=87, FORMAT='TABLEAU', SEPARATEUR=',', FORMAT_R='1PE18.10')
FIN()
