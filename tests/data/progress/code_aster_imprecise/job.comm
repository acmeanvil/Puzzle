DEBUT(LANG='EN')
mesh = LIRE_MAILLAGE(FORMAT='MED', UNITE=20)
model = AFFE_MODELE(MAILLAGE=mesh, AFFE=(_F(TOUT='OUI', PHENOMENE='MECANIQUE', MODELISATION='3D'),))
mat1 = DEFI_MATERIAU(ELAS=_F(E=68900000000, NU=0.33, RHO=2700))
mater = AFFE_MATERIAU(MAILLAGE=mesh, AFFE=(_F(GROUP_MA='G1', MATER=mat1),))
load = AFFE_CHAR_MECA(MODELE=model, DDL_IMPO=(_F(GROUP_MA='G2', DX=0.0, DY=0.0, DZ=0.0),), PRES_REP=(_F(GROUP_MA='G3', PRES=30000000),))
res = MECA_STATIQUE(MODELE=model, CHAM_MATER=mater, EXCIT=(_F(CHARGE=load),))
res = CALC_CHAMP(reuse=res, RESULTAT=res, CONTRAINTE=('SIGM_NOEU',), FORCE=('REAC_NODA',))
IMPR_TABLE(TABLE=CREA_TABLE(RESU=_F(RESULTAT=res, NOM_CHAM='DEPL', TOUT_CMP='OUI', TOUT='OUI')), UNITE=81, FORMAT='TABLEAU', SEPARATEUR=',', FORMAT_R='1PE18.10')
IMPR_TABLE(TABLE=CREA_TABLE(RESU=_F(RESULTAT=res, NOM_CHAM='SIGM_NOEU', TOUT_CMP='OUI', TOUT='OUI')), UNITE=82, FORMAT='TABLEAU', SEPARATEUR=',', FORMAT_R='1PE18.10')
IMPR_TABLE(TABLE=CREA_TABLE(RESU=_F(RESULTAT=res, NOM_CHAM='REAC_NODA', TOUT_CMP='OUI', TOUT='OUI')), UNITE=85, FORMAT='TABLEAU', SEPARATEUR=',', FORMAT_R='1PE18.10')
FIN()
