DEBUT(LANG='EN')
mesh = LIRE_MAILLAGE(FORMAT='MED', UNITE=20)
mesh = MODI_MAILLAGE(reuse=mesh, MAILLAGE=mesh, ORIE_PEAU=_F(GROUP_MA_PEAU=('G10', 'G9',)))
mesh = DEFI_GROUP(reuse=mesh, MAILLAGE=mesh, CREA_GROUP_NO=_F(GROUP_MA=('PR1', 'P1A1', 'P1B1', 'PR2', 'P2A1', 'P2B1',)))
mesh = DEFI_GROUP(reuse=mesh, MAILLAGE=mesh, CREA_GROUP_NO=_F(GROUP_MA=('T1A', 'T1B', 'E1A', 'E1B', 'T2A', 'T2B', 'E2A', 'E2B', 'G5', 'G6', 'G7', 'G8',)))
model = AFFE_MODELE(MAILLAGE=mesh, AFFE=(_F(TOUT='OUI', PHENOMENE='MECANIQUE', MODELISATION='3D'), _F(GROUP_MA='F1', PHENOMENE='MECANIQUE', MODELISATION='POU_D_T'), _F(GROUP_MA='F2', PHENOMENE='MECANIQUE', MODELISATION='POU_D_T'), _F(GROUP_MA='PRETENSION', PHENOMENE='MECANIQUE', MODELISATION='DIS_T'),))
cara = AFFE_CARA_ELEM(MODELE=model, DISCRET=(
    _F(GROUP_MA='PR1', CARA='K_T_D_N', VALE=(3.443232e+01, 0.0, 0.0)),
    _F(GROUP_MA='PR2', CARA='K_T_D_N', VALE=(3.443232e+01, 0.0, 0.0)),
), POUTRE=(
    _F(GROUP_MA='F1', SECTION='CERCLE', CARA=('R',), VALE=(0.004,)),
    _F(GROUP_MA='F2', SECTION='CERCLE', CARA=('R',), VALE=(0.004,)),
), ORIENTATION=(
    _F(GROUP_MA='F1', CARA='VECT_Y', VALE=(0, -0.999999954917, 0.000300278074962)),
    _F(GROUP_MA='F2', CARA='VECT_Y', VALE=(0, -0.999999992395, 0.00012332799269)),
))
mat1 = DEFI_MATERIAU(ELAS=_F(E=210000000000, NU=0.3, RHO=7850))
mat2 = DEFI_MATERIAU(ELAS=_F(E=210000000000, NU=0.3, RHO=7850))
matf1 = DEFI_MATERIAU(ELAS=_F(E=210000000000, NU=0.3, RHO=7850))
matf2 = DEFI_MATERIAU(ELAS=_F(E=210000000000, NU=0.3, RHO=7850))
mater = AFFE_MATERIAU(MAILLAGE=mesh, AFFE=(_F(GROUP_MA='G1', MATER=mat1), _F(GROUP_MA='G2', MATER=mat2), _F(GROUP_MA='F1', MATER=matf1), _F(GROUP_MA='F2', MATER=matf2),))
load = AFFE_CHAR_MECA(MODELE=model, DDL_IMPO=(_F(GROUP_MA='G3', DX=0.0, DY=0.0, DZ=0.0), _F(GROUP_NO='PR1', DY=0.0, DZ=0.0), _F(GROUP_NO='PR2', DY=0.0, DZ=0.0),), FORCE_NODALE=(_F(GROUP_NO='PR1', FX=-5000), _F(GROUP_NO='PR2', FX=-5000),), LIAISON_DDL=(_F(GROUP_NO=('P1B1', 'P1A1', 'PR1',), DDL=('DX', 'DX', 'DX',), COEF_MULT=(1, -1, 0.000489869020996,), COEF_IMPO=0.0), _F(GROUP_NO=('P1B1', 'P1A1', 'PR1',), DDL=('DY', 'DY', 'DX',), COEF_MULT=(1, -1, 0.000300278038933,), COEF_IMPO=0.0), _F(GROUP_NO=('P1B1', 'P1A1', 'PR1',), DDL=('DZ', 'DZ', 'DX',), COEF_MULT=(1, -1, 0.999999834931,), COEF_IMPO=0.0), _F(GROUP_NO=('P2B1', 'P2A1', 'PR2',), DDL=('DX', 'DX', 'DX',), COEF_MULT=(1, -1, 0.000214879298321,), COEF_IMPO=0.0), _F(GROUP_NO=('P2B1', 'P2A1', 'PR2',), DDL=('DY', 'DY', 'DX',), COEF_MULT=(1, -1, 0.000123327989843,), COEF_IMPO=0.0), _F(GROUP_NO=('P2B1', 'P2A1', 'PR2',), DDL=('DZ', 'DZ', 'DX',), COEF_MULT=(1, -1, 0.999999969309,), COEF_IMPO=0.0), _F(GROUP_NO=('T1B', 'T1A'), DDL=('DRX', 'DRX'), COEF_MULT=(1.0, -1.0), COEF_IMPO=0.0), _F(GROUP_NO=('T1B', 'T1A'), DDL=('DRY', 'DRY'), COEF_MULT=(1.0, -1.0), COEF_IMPO=0.0), _F(GROUP_NO=('T1B', 'T1A'), DDL=('DRZ', 'DRZ'), COEF_MULT=(1.0, -1.0), COEF_IMPO=0.0), _F(GROUP_NO=('T2B', 'T2A'), DDL=('DRX', 'DRX'), COEF_MULT=(1.0, -1.0), COEF_IMPO=0.0), _F(GROUP_NO=('T2B', 'T2A'), DDL=('DRY', 'DRY'), COEF_MULT=(1.0, -1.0), COEF_IMPO=0.0), _F(GROUP_NO=('T2B', 'T2A'), DDL=('DRZ', 'DRZ'), COEF_MULT=(1.0, -1.0), COEF_IMPO=0.0),), FORCE_FACE=(_F(GROUP_MA='G4', FY=-1041666.66667),), LIAISON_RBE3=(_F(GROUP_NO_MAIT='E1A', DDL_MAIT=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'), GROUP_NO_ESCL=('G5',), DDL_ESCL=('DX-DY-DZ',), COEF_ESCL=(1.0,)), _F(GROUP_NO_MAIT='E1B', DDL_MAIT=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'), GROUP_NO_ESCL=('G6',), DDL_ESCL=('DX-DY-DZ',), COEF_ESCL=(1.0,)), _F(GROUP_NO_MAIT='E2A', DDL_MAIT=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'), GROUP_NO_ESCL=('G7',), DDL_ESCL=('DX-DY-DZ',), COEF_ESCL=(1.0,)), _F(GROUP_NO_MAIT='E2B', DDL_MAIT=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'), GROUP_NO_ESCL=('G8',), DDL_ESCL=('DX-DY-DZ',), COEF_ESCL=(1.0,)),))
contact = DEFI_CONTACT(MODELE=model, FORMULATION='CONTINUE', FROTTEMENT='COULOMB', ZONE=(_F(GROUP_MA_MAIT='G10', GROUP_MA_ESCL='G9', SANS_GROUP_NO=('G5', 'G7',), COULOMB=0.2),), ALGO_RESO_FROT='POINT_FIXE', ALGO_RESO_CONT='POINT_FIXE')
ramp = DEFI_FONCTION(NOM_PARA='INST', VALE=(0.0, 0.0, 1.0, 1.0))
times = DEFI_LIST_INST(DEFI_LIST=_F(LIST_INST=DEFI_LIST_REEL(DEBUT=0.0, INTERVALLE=_F(JUSQU_A=1.0, NOMBRE=1))), ECHEC=_F(EVENEMENT='ERREUR', ACTION='DECOUPE', SUBD_METHODE='MANUEL', SUBD_PAS=4, SUBD_NIVEAU=5))
res = STAT_NON_LINE(MODELE=model, CHAM_MATER=mater, CARA_ELEM=cara, EXCIT=(_F(CHARGE=load, FONC_MULT=ramp),), CONTACT=contact, COMPORTEMENT=(_F(TOUT='OUI', RELATION='ELAS'),), NEWTON=_F(REAC_ITER=1), CONVERGENCE=_F(ITER_GLOB_MAXI=200, RESI_GLOB_RELA=1e-6), INCREMENT=_F(LIST_INST=times))
res = CALC_CHAMP(reuse=res, RESULTAT=res, CONTRAINTE=('SIGM_NOEU', 'EFGE_NOEU',), FORCE=('REAC_NODA',))
IMPR_TABLE(TABLE=CREA_TABLE(RESU=_F(RESULTAT=res, NOM_CHAM='DEPL', INST=1.0, TOUT_CMP='OUI', TOUT='OUI')), UNITE=81, FORMAT='TABLEAU', SEPARATEUR=',', FORMAT_R='1PE18.10')
IMPR_TABLE(TABLE=CREA_TABLE(RESU=_F(RESULTAT=res, NOM_CHAM='SIGM_NOEU', INST=1.0, TOUT_CMP='OUI', TOUT='OUI')), UNITE=82, FORMAT='TABLEAU', SEPARATEUR=',', FORMAT_R='1PE18.10')
IMPR_TABLE(TABLE=CREA_TABLE(RESU=_F(RESULTAT=res, NOM_CHAM='REAC_NODA', INST=1.0, TOUT_CMP='OUI', TOUT='OUI')), UNITE=85, FORMAT='TABLEAU', SEPARATEUR=',', FORMAT_R='1PE18.10')
IMPR_TABLE(TABLE=CREA_TABLE(RESU=_F(RESULTAT=res, NOM_CHAM='EFGE_NOEU', INST=1.0, TOUT_CMP='OUI', TOUT='OUI')), UNITE=89, FORMAT='TABLEAU', SEPARATEUR=',', FORMAT_R='1PE18.10')
FIN()
