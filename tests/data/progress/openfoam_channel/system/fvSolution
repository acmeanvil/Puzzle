FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object fvSolution;
}

solvers
{
    p
    {
        solver GAMG;
        smoother GaussSeidel;
        tolerance 1e-09;
        relTol 0.01;
    }
    "(U|k|epsilon|omega)"
    {
        solver smoothSolver;
        smoother symGaussSeidel;
        tolerance 1e-09;
        relTol 0.1;
    }
    T
    {
        solver GAMG;
        smoother GaussSeidel;
        tolerance 1e-10;
        relTol 0;
    }
}
SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent on;
    residualControl
    {
        p 1e-06;
        U 1e-07;
    }
}
relaxationFactors
{
    equations
    {
        U 0.9;
        ".*" 0.9;
        T 1;
    }
}
