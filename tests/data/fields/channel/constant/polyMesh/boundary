/*--------------------------------*- C++ -*----------------------------------*\
  A two-cell case for Puzzle's OpenFOAM field reader (ADR 0044), written by hand.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

3
(
    inlet
    {
        type            patch;
        nFaces          1;
        startFace       1;
    }
    outlet
    {
        type            patch;
        nFaces          1;
        startFace       2;
    }
    walls
    {
        type            wall;
        inGroups        List<word> 1(wall);
        nFaces          8;
        startFace       3;
    }
)
